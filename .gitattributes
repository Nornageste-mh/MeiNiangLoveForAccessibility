# 统一换行符与文本属性，避免 Git 反复提示 CRLF/LF 转换

* text=auto

# Windows 脚本：仓库内 LF，检出为 CRLF
# 注意：.ps1 必须带 UTF-8 BOM，否则 Windows PowerShell 5.1 会按 GBK 解读中文
# 导致语法错误。BOM 属于文件内容，不受换行符归一化影响。
*.ps1     text eol=crlf

# Ren'Py 脚本、文档、测试用例
*.rpy     text eol=lf
*.md      text eol=lf
*.psd1    text eol=lf
*.txt     text eol=crlf

# 二进制（正常不应入库，此处兜底）
*.dll     binary
*.zip     binary
*.exe     binary
*.rpa     binary